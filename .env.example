# Erstinstallation: node scripts/setup-env.mjs (erzeugt fehlende lokale Secrets).
# Nie committen. Twitch-Werte ausschließlich im Worker; Web erhält sie nicht.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_GAME_ID=
POLL_INTERVAL_SECONDS=60
COLLECTION_BUDGET_SECONDS=40
MAX_STREAM_PAGES=400
HISTORY_RETENTION_DAYS=30

POSTGRES_DB=gtavi
POSTGRES_USER=gtavi
POSTGRES_PASSWORD=
# Optional, für eine externe PostgreSQL-Datenbank. Sonst obige Einzelwerte nutzen.
# Sonderzeichen in einer URL müssen URL-encodiert sein.
DATABASE_URL=
DB_POOL_SIZE=5

# Lokaler Node-Betrieb nutzt weiterhin die vorhandene SQLite-Datenbank.
DATABASE_PATH=./data/leonida.sqlite
# Docker Compose wählt PostgreSQL unabhängig hiervon.
DATABASE_DRIVER=sqlite
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
WEB_PORT=3000
# Sichere Voreinstellung für Reverse Proxy auf demselben Host.
# Für einen Proxy in einem anderen Netzwerk gezielt auf eine erreichbare IP setzen.
WEB_BIND_ADDRESS=127.0.0.1

GHCR_IMAGE=ghcr.io/celduinx/leonida-viewers
IMAGE_TAG=latest
# Mindestens 32 Zeichen. setup-env erzeugt 64 zufällige Hex-Zeichen.
ADMIN_TOKEN=
# Nur für optionale, geschützte Cloudflare-/externe Abruf-Endpunkte.
CRON_TOKEN=
