{
  "name": "leonida-live",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "worker": "node --env-file-if-exists=.env scripts/worker.mjs",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "test:postgres": "node --test tests/postgres.integration.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
